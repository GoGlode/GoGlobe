# Copy to .env; start with: uvicorn app.main:app --env-file .env
# --env-file requires: pip install python-dotenv
# Non-empty comma-separated HTTP(S) origins; no paths, credentials, query or fragment.
GOGLOBE_CORS_ORIGINS=https://goglobe-demo.vercel.app,http://localhost:3000,http://localhost:5173,http://localhost:8000,http://127.0.0.1:8000
GOGLOBE_DB_PATH=data/goglobe.sqlite3
# Whole planning deadline: >0 and <=120 seconds.
GOGLOBE_AGENT_TIMEOUT_SECONDS=20
# Booleans accept only true/false (case-insensitive).
GOGLOBE_ENABLE_DOCS=false
# Provider implementation: exactly live or snapshot.
GOGLOBE_PROVIDERS=snapshot
# Cache TTL >=0 seconds; 0 disables the process-local cache.
GOGLOBE_CACHE_TTL_SECONDS=60
# Per-attempt timeout: >0 and <=120 seconds.
GOGLOBE_PROVIDER_TIMEOUT_SECONDS=8
# Total attempts including the first (one initial attempt plus two retries): integer 1..3.
GOGLOBE_PROVIDER_MAX_ATTEMPTS=3
# Explicit opt-in only. Uses supported demo fixtures, never live booking data.
GOGLOBE_DEMO_FALLBACK=false
# Following settings apply only to app.legacy_api:create_app: 0..10, >=1, and >0..120.
GOGLOBE_MOCK_DELAY_SECONDS=0.15
GOGLOBE_MAX_SEARCHES=500
GOGLOBE_LEGACY_TIMEOUT_SECONDS=20
