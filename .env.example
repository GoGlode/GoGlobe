# Скопируйте в .env и заполните. Секреты в git не коммитим!
# --- backend ---
GOGLOBE_ENV=dev
# Только snapshot | live; live без адаптеров завершается контролируемой ошибкой.
GOGLOBE_PROVIDERS=snapshot
GOGLOBE_PROVIDER_TIMEOUT_SECONDS=8
GOGLOBE_PROVIDER_MAX_ATTEMPTS=3
GOGLOBE_CACHE_TTL_SECONDS=600
# mock | llm — как агент разбирает запрос
GOGLOBE_PARSER=mock
GOGLOBE_CORS_ORIGINS=http://localhost:5173,https://goglobe-demo.vercel.app
# Ключи внешних сервисов (Backend №1 / №2 добавляют по мере подключения)
LLM_API_KEY=
FLIGHTS_API_KEY=
HOTELS_API_KEY=
# --- frontend ---
VITE_API_URL=http://localhost:8000
