# Скопируйте в .env и заполните. Секреты в git не коммитим!
# --- backend ---
GOGLOBE_ENV=dev
# mock | live — какие провайдеры данных использовать (по умолчанию mock)
GOGLOBE_PROVIDERS=mock
# mock | llm — как агент разбирает запрос
GOGLOBE_PARSER=mock
GOGLOBE_CORS_ORIGINS=http://localhost:5173
# Ключи внешних сервисов (Backend №1 / №2 добавляют по мере подключения)
LLM_API_KEY=
FLIGHTS_API_KEY=
HOTELS_API_KEY=
# --- frontend ---
VITE_API_URL=http://localhost:8000
